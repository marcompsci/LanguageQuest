  "culturalNotes": [
    {
      "id": "amn-u1-1",
      "title": "The Fidel script",
      "body": "Amharic is written in Ge'ez (Fidel), where each symbol is a whole syllable: ለ le, ሉ lu, ሊ li, ላ la. There are more than 200 of them!"
    },
    {
      "id": "amn-u1-2",
      "title": "Selam and lots of greetings",
      "body": "Selam means peace and hello. Ethiopians often greet with several questions in a row (are you well? is your family well?) and a shoulder bump between friends."
    },
    {
      "id": "amn-u1-3",
      "title": "Coffee ceremony",
      "body": "Coffee (buna) comes from Ethiopia. Families hold a coffee ceremony, roasting the beans and serving three rounds to friends and neighbors."
    }
  ],
