  "culturalNotes": [
    {
      "id": "den-u1-1",
      "title": "Du and Sie",
      "body": "German has a friendly “you” (du) for friends, family and kids, and a polite “you” (Sie, always with a capital S) for adults you don't know well."
    },
    {
      "id": "den-u1-2",
      "title": "Every noun has a capital",
      "body": "In German every noun starts with a capital letter: der Hund (the dog), die Schule (the school). It makes nouns easy to spot!"
    },
    {
      "id": "den-u1-3",
      "title": "Hello across the German-speaking world",
      "body": "Hallo works everywhere. In the south of Germany and in Austria you'll also hear Grüß Gott and Servus, and in Switzerland Grüezi."
    }
  ],
