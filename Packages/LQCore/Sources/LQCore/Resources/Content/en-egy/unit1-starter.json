  "culturalNotes": [
    {
      "id": "egyn-u1-1",
      "title": "God's words",
      "body": "Egyptians called hieroglyphs medu netjer, “god's words”. They were carved on temples and tombs for more than 3,000 years. The ankh (☥) means life."
    },
    {
      "id": "egyn-u1-2",
      "title": "Where did the vowels go?",
      "body": "Hieroglyphs only wrote consonants, so nobody knows exactly how Egyptian sounded. Egyptologists add an “e” between consonants: nfr becomes nefer, ḥtp becomes hotep."
    },
    {
      "id": "egyn-u1-3",
      "title": "Life, prosperity, health",
      "body": "Letters and royal names were often followed by ankh, wedja, seneb: life, prosperity, health! Egyptian lives on today in Coptic, still used in Coptic church services."
    }
  ],
