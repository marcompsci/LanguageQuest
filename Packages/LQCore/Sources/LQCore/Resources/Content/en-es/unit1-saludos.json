  "culturalNotes": [
    {
      "id": "n-u1-usted",
      "title": "Tú and usted",
      "body": "Spanish has a friendly “you” (tú) and a polite “you” (usted). Kids usually use usted with grown-ups they don't know well, like a baker or a teacher. Titles like Don and Doña show respect for older people.",
      "byVariant": {
        "es-AR": "In Argentina, friends say vos instead of tú: ¿Cómo te llamás? Usted is still used for respect.",
        "es-CO": "In Colombia, usted is very common, even between friends and family."
      }
    },
    {
      "id": "n-u1-besos",
      "title": "Hello with a kiss",
      "body": "In many Spanish-speaking places, friends and family greet with a light kiss on the cheek. Handshakes are common for first meetings.",
      "byVariant": {
        "es-ES": "In Spain, friends often greet with two kisses, one on each cheek.",
        "es-AR": "In Argentina, one kiss on the cheek is a normal hello, even between friends who are boys."
      }
    },
    {
      "id": "n-u1-tardes",
      "title": "When is “la tarde”?",
      "body": "Buenos días is for the morning, buenas tardes for after lunch until it gets dark, and buenas noches for the evening and for going to bed. Many people just say “¡Buenas!”"
    }
  ],
