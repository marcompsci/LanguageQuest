  "culturalNotes": [
    {
      "id": "n-u2-apellidos",
      "title": "Two last names",
      "body": "Many people in Spanish-speaking countries have two last names (apellidos): one from their dad's family and one from their mom's. Mateo Ruiz López has Ruiz from his dad and López from his mom.",
      "byVariant": {
        "es-AR": "In Argentina, many people use just one last name day to day, even if they have two."
      }
    },
    {
      "id": "n-u2-abuelos",
      "title": "Grandparents close by",
      "body": "It's common for grandparents to live with their family or very close by, and to help raise the grandkids. Grown-ups often call kids “mi amor” or “mi vida” as a sweet nickname."
    },
    {
      "id": "n-u2-padrinos",
      "title": "Padrinos",
      "body": "Many families have padrinos (godparents): special grown-ups chosen to look after a child as they grow. A padrino or madrina is often like part of the family."
    }
  ],
