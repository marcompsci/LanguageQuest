  "culturalNotes": [
    {
      "id": "n-u3-mercados",
      "title": "Open-air markets",
      "body": "Many towns have a mercado where families buy fresh fruit, vegetables, bread and cheese from people they know by name. Shopkeepers often greet regular customers with “¿Qué le doy?” (What can I give you?).",
      "byVariant": {
        "es-MX": "In Mexico, a tianguis is a street market that pops up on a certain day of the week.",
        "es-ES": "In Spain, many towns have a covered market (mercado de abastos)."
      }
    },
    {
      "id": "n-u3-tortilla",
      "title": "Same word, different food",
      "body": "A tortilla in Mexico is a thin flatbread made of corn or flour. In Spain, a tortilla is a thick omelet made with eggs and potatoes!",
      "byVariant": {
        "es-ES": "In Spain, la tortilla española is made with eggs, potatoes and often onion.",
        "es-MX": "In Mexico, tortillas are part of almost every meal, from tacos to quesadillas."
      }
    },
    {
      "id": "n-u3-dinero",
      "title": "Money",
      "body": "Different countries use different money. Market examples follow the variant you chose.",
      "byVariant": {
        "es-419": "Examples use pesos.",
        "es-MX": "Mexico uses the peso.",
        "es-ES": "Spain uses the euro.",
        "es-AR": "Argentina uses the peso.",
        "es-CO": "Colombia uses the peso.",
        "es-PR": "Puerto Rico uses the U.S. dollar."
      }
    },
    {
      "id": "n-u3-provecho",
      "title": "¡Buen provecho!",
      "body": "Before or during a meal, people say “¡Buen provecho!”: enjoy your meal. It's polite to say it even to strangers eating nearby."
    }
  ],
