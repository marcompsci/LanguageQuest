  "culturalNotes": [
    {
      "id": "fn-u1-tuvous",
      "title": "Tu and vous",
      "body": "French has a friendly “you” (tu) and a polite “you” (vous). Use vous with adults you don't know well, like a shopkeeper or a teacher, and tu with friends and family.",
      "byVariant": {
        "fr-CA": "In Québec, tu is used more often than in France, even with some adults. Vous is still polite with strangers."
      }
    },
    {
      "id": "fn-u1-bise",
      "title": "La bise",
      "body": "Friends and family often greet with la bise: light kisses on the cheeks. A handshake is normal for a first meeting.",
      "byVariant": {
        "fr-FR": "In France the number of kisses depends on the region: two in Paris, but three or even four in some places!",
        "fr-CA": "In Québec, friends often do two kisses, but a hug or a wave is common too."
      }
    },
    {
      "id": "fn-u1-bonjour",
      "title": "Always say bonjour",
      "body": "Saying bonjour when you walk into a shop or a bakery is important. Skipping it can seem rude. In the evening, people switch to bonsoir.",
      "byVariant": {
        "fr-CA": "In Québec, people often say bonne journée (have a good day) when leaving."
      }
    }
  ],
