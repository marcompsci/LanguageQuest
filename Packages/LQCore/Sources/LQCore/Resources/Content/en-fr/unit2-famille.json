  "culturalNotes": [
    {
      "id": "fn-u2-mamie",
      "title": "Mamie and papi",
      "body": "French kids have lots of cute names for grandparents: mamie, mémé, papi, pépé. Many families eat a long Sunday lunch together with the grandparents."
    },
    {
      "id": "fn-u2-parrain",
      "title": "Parrain and marraine",
      "body": "Many children have a parrain (godfather) and a marraine (godmother), special adults who give advice and celebrate birthdays with them."
    },
    {
      "id": "fn-u2-mon",
      "title": "Mon, ma, mes",
      "body": "“My” changes in French: mon frère (boy words), ma sœur (girl words), mes amis (more than one). Before a vowel sound, it's always mon: mon amie."
    }
  ],
