  "culturalNotes": [
    {
      "id": "fn-u3-marche",
      "title": "Open-air markets",
      "body": "Many French towns have a market once or twice a week, with fresh fruit, cheese, bread and flowers. Shoppers greet the sellers with bonjour first.",
      "byVariant": {
        "fr-CA": "In Québec, big public markets like the Marché Jean-Talon in Montréal sell local maple syrup and berries."
      }
    },
    {
      "id": "fn-u3-repas",
      "title": "Breakfast, lunch, dinner",
      "body": "Meal names differ by region.",
      "byVariant": {
        "fr-FR": "In France: le petit-déjeuner (breakfast), le déjeuner (lunch), le dîner (dinner).",
        "fr-CA": "In Québec: le déjeuner (breakfast), le dîner (lunch), le souper (dinner)."
      }
    },
    {
      "id": "fn-u3-argent",
      "title": "Money",
      "body": "Market prices follow the variant you chose.",
      "byVariant": {
        "fr-FR": "France uses the euro.",
        "fr-CA": "Canada uses the Canadian dollar."
      }
    },
    {
      "id": "fn-u3-appetit",
      "title": "Bon appétit !",
      "body": "Before eating, people say bon appétit: enjoy your meal. In France, the baguette is a daily favorite, often bought fresh every morning."
    }
  ],
