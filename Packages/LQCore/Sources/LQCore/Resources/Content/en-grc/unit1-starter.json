  "culturalNotes": [
    {
      "id": "grcn-u1-1",
      "title": "Alpha, beta…",
      "body": "The word alphabet comes from the first two Greek letters, alpha (α) and beta (β). Thousands of English words come from Greek: telephone, dinosaur, planet…"
    },
    {
      "id": "grcn-u1-2",
      "title": "Accents and breathings",
      "body": "Ancient Greek marks pitch accents (ά ὰ ᾶ) and “breathings” on words starting with a vowel: ἁ means an h sound (ha), ἀ means none (a)."
    },
    {
      "id": "grcn-u1-3",
      "title": "The agora",
      "body": "The agora (ἀγορά) was the heart of a Greek city: a market where people also met to talk, argue and vote."
    }
  ],
