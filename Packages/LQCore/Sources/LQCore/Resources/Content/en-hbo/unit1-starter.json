  "culturalNotes": [
    {
      "id": "hbon-u1-1",
      "title": "Letters first, vowels later",
      "body": "The Bible was first written with consonants only. Around 1,000 years ago scholars called Masoretes added the dots and lines (vowel points) so the reading would never be forgotten."
    },
    {
      "id": "hbon-u1-2",
      "title": "Bread house",
      "body": "Many place names are Hebrew words: Bethlehem is בֵּית לֶחֶם (beit lechem), the house of bread. Our village bakery uses the same words!"
    },
    {
      "id": "hbon-u1-3",
      "title": "Words you already know",
      "body": "English borrowed Biblical Hebrew words like amen (so be it), hallelujah (praise God) and shalom (peace)."
    }
  ],
