  "culturalNotes": [
    {
      "id": "hen-u1-1",
      "title": "Shalom",
      "body": "Shalom means peace, and it's used for both hello and goodbye. On Fridays people wish each other Shabbat shalom, a peaceful Sabbath."
    },
    {
      "id": "hen-u1-2",
      "title": "Right to left",
      "body": "Hebrew is written from right to left, and everyday writing leaves out most vowels. Children's books add little dots and lines (vowel points) to help new readers."
    },
    {
      "id": "hen-u1-3",
      "title": "Boy or girl “you”",
      "body": "Hebrew changes “you” for a boy or a girl: ve'ata? (and you?) to a boy, ve'at? to a girl. Lessons show the form for a boy and note the girl's form."
    }
  ],
