  "culturalNotes": [
    {
      "id": "itn-u1-1",
      "title": "Tu and Lei",
      "body": "Italian has a friendly “you” (tu) and a polite “you” (Lei) for adults you don't know well, like a shopkeeper or a teacher."
    },
    {
      "id": "itn-u1-2",
      "title": "Ciao both ways",
      "body": "Ciao means both hi and bye between friends. With adults, use buongiorno during the day and buonasera from the afternoon on."
    },
    {
      "id": "itn-u1-3",
      "title": "Two kisses",
      "body": "Friends and family often greet with two light kisses on the cheeks, starting on the right. A handshake is normal for a first meeting."
    }
  ],
