  "culturalNotes": [
    {
      "id": "jn-u1-ojigi",
      "title": "Bowing",
      "body": "In Japan people often bow (おじぎ) when they say hello, thank you or sorry. A small nod is fine between friends; a deeper bow shows more respect."
    },
    {
      "id": "jn-u1-genki",
      "title": "Not every day: げんき です か",
      "body": "げんき です か literally asks “are you well?”. People use it when they haven't seen someone for a while, not as an everyday “how are you”. Day to day, a simple おはよう or こんにちは is enough."
    },
    {
      "id": "jn-u1-san",
      "title": "-san and sensei",
      "body": "People add -さん after someone's name to be polite: ローザ さん (Ms. Rosa). Teachers are せんせい: ソル せんせい. You never add -さん to your own name."
    }
  ],
