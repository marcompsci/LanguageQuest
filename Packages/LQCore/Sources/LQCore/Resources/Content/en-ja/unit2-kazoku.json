  "culturalNotes": [
    {
      "id": "jn-u2-family",
      "title": "Older and younger",
      "body": "Japanese has different words for older and younger siblings: おにいさん (older brother) and おとうと (younger brother), おねえさん (older sister) and いもうと (younger sister). Age matters in how people speak to each other."
    },
    {
      "id": "jn-u2-mine",
      "title": "My mom vs. your mom",
      "body": "When talking about your own family to others, Japanese uses humble words: はは (my mother) and ちち (my father). おかあさん and おとうさん are for someone else's parents, or for calling your own."
    },
    {
      "id": "jn-u2-ao",
      "title": "Is it blue or green?",
      "body": "In Japan, the green traffic light is called あお (blue)! Long ago, あお covered both blue and green, and the name stuck."
    }
  ],
