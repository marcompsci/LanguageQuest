  "culturalNotes": [
    {
      "id": "jn-u3-dagashi",
      "title": "Candy shops",
      "body": "Traditional だがしや (candy shops) sell sweets for just a few ¥10 coins. Kids stop by after school to choose snacks with their pocket money."
    },
    {
      "id": "jn-u3-itadakimasu",
      "title": "いただきます",
      "body": "Before eating, everyone says いただきます (I humbly receive), often with hands together. After the meal, they say ごちそうさま でした to thank the cook."
    },
    {
      "id": "jn-u3-yen",
      "title": "Yen",
      "body": "Japan uses the yen (えん, ¥). There are no cents: coins go from ¥1 up to ¥500. Market Rush prices are in hundreds of yen."
    },
    {
      "id": "jn-u3-katakana",
      "title": "Katakana words",
      "body": "Words that came from other languages are written in katakana: バナナ (banana), パン (bread, from Portuguese), ジュース (juice). Many of them sound like the English word!"
    }
  ],
