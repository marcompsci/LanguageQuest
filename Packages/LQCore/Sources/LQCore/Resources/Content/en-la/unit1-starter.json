  "culturalNotes": [
    {
      "id": "lan-u1-1",
      "title": "Latin is everywhere",
      "body": "Spanish, French, Italian, Portuguese and Romanian grew out of Latin, and about half of English words come from it too: aqua (water) → aquarium."
    },
    {
      "id": "lan-u1-2",
      "title": "How Romans sounded",
      "body": "In classical Latin, c is always k (Cicero = KI-ke-ro) and v sounds like w (veni, vidi, vici = WAY-nee, WEE-dee, WEE-kee)."
    },
    {
      "id": "lan-u1-3",
      "title": "One or many",
      "body": "Latin changes greetings for one person or several: salve / salvete (hello), vale / valete (goodbye)."
    }
  ],
