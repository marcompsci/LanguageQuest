  "culturalNotes": [
    {
      "id": "zhn-u1-1",
      "title": "Four tones",
      "body": "Mandarin has four tones (plus a light one). Mā, má, mǎ and mà are different words! The marks in pinyin show the tone."
    },
    {
      "id": "zhn-u1-2",
      "title": "Have you eaten?",
      "body": "A friendly everyday greeting is 你吃了吗？ (nǐ chī le ma?, have you eaten?). It's a way of saying you care, not an invitation."
    },
    {
      "id": "zhn-u1-3",
      "title": "Counting on one hand",
      "body": "In China you can show the numbers 6 to 10 with one hand. Six is a thumb and little finger, like a phone sign."
    }
  ],
